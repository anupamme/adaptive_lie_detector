\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: Adversary equilibrium utility vs.\ data heterogeneity ($\alpha $) for different adversarial fractions. Right: Value of Private Defense vs.\ adversarial fraction for different heterogeneity levels. Adversary equilibrium utility is non-monotone in $\alpha $: at low adversarial fractions ($f=0.1$), moderate non-IID ($\alpha =0.3$) maximizes attack effectiveness, while at higher fractions ($f=0.4$), lower $\alpha $ consistently helps the adversary. Higher $f$ increases both adversary utility and the value of defense secrecy.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sweep}{{2}{7}{Left: Adversary equilibrium utility vs.\ data heterogeneity ($\alpha $) for different adversarial fractions. Right: Value of Private Defense vs.\ adversarial fraction for different heterogeneity levels. Adversary equilibrium utility is non-monotone in $\alpha $: at low adversarial fractions ($f=0.1$), moderate non-IID ($\alpha =0.3$) maximizes attack effectiveness, while at higher fractions ($f=0.4$), lower $\alpha $ consistently helps the adversary. Higher $f$ increases both adversary utility and the value of defense secrecy}{figure.caption.4}{}}
