\newlabel{tab:accuracy}{{1}{5}{Clean test accuracy (mean over 3 seeds) and attack success rate (ASR) for each (attack, defense) pair on CIFAR-10 with $\alpha =0.5$, $f=0.2$, 50 rounds. Std for accuracy is ${\leq }0.01$ except Krum (${\leq }0.08$). Backdoor attacks (pixel, model scaling, DBA) report ASR; others report 0}{table.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Nash equilibria of the empirical game ($\alpha =0.5$, $f=0.2$, 50 rounds, 3 seeds). $U_A$ and $U_D$ denote equilibrium utilities. VoPD is the Value of Private Defense (Eq.~\ref {eq:vopd}).}}{5}{table.caption.2}\protected@file@percent }
\newlabel{tab:equilibria}{{2}{5}{Nash equilibria of the empirical game ($\alpha =0.5$, $f=0.2$, 50 rounds, 3 seeds). $U_A$ and $U_D$ denote equilibrium utilities. VoPD is the Value of Private Defense (Eq.~\ref {eq:vopd})}{table.caption.2}{}}
